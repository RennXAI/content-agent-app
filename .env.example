ANTHROPIC_API_KEY=your_anthropic_api_key_here

# GoHighLevel (GHL) v2 API — Private Integration Tokens (pit-...)
GHL_API_KEY=pit-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
GHL_LOCATION_API_KEY=pit-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
GHL_LOCATION_ID=your_location_id_here
GHL_API_VERSION=2021-07-28
# Required for Social Planner POST. Find via GHL > Settings > My Staff > click your user; the URL contains the userId.
GHL_USER_ID=

# Canva template references — 11-char design IDs from canva.com/design/{id}
CANVA_CAROUSEL_TEMPLATE_ID=
CANVA_REEL_TEMPLATE_ID=
CANVA_BRAND_KIT_ID=

# Optional alternative LLM
GEMINI_API_KEY=
